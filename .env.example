# Generate SECRET_KEY and POSTGRES_PASSWORD independently with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
# Do not commit .env. Compose reads it; manage.py reads exported environment variables.
DEBUG=false
SECRET_KEY=
POSTGRES_PASSWORD=
# Generate APP_DB_PASSWORD as hex (safe for both SQL literal and URI):
# python -c "import secrets; print(secrets.token_hex(32))"
APP_DB_PASSWORD=
ALLOWED_HOSTS=pharmacy.example.com
CSRF_TRUSTED_ORIGINS=https://pharmacy.example.com
TRUST_PROXY=true
# For non-Compose execution, export a URL with URL-encoded credentials:
DATABASE_URL=postgresql://medicare:CHANGE_ME@127.0.0.1:5432/medicare
